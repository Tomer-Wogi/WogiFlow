# WogiFlow environment variables
# Copy to .env and fill in the API keys you want to use.
# Only required when using the optional AI-powered features (correction
# detection, conclusion classification, peer review, etc.). Absence of a key
# is handled gracefully — features degrade to skip-with-warning.

# -----------------------------------------------------------------------------
# Required for most AI features (Haiku-based classifiers + adversary passes)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Optional — enables multi-model peer review (/wogi-peer-review),
# OpenAI-backed providers in hybrid mode, etc.
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# -----------------------------------------------------------------------------
# Debug / verbose output (any non-empty value enables)
# -----------------------------------------------------------------------------
# DEBUG=1

# -----------------------------------------------------------------------------
# Task-boundary session restart (wogi-claude wrapper) internals — usually
# managed automatically, do not set manually except for troubleshooting.
# -----------------------------------------------------------------------------
# WOGI_WRAPPER_PID=
# WOGI_RESTART_FLAG=
