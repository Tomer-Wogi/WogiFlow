# Wogi Flow — Example Environment File
#
# Copy to `.env` (gitignored) and fill in values. None of these are
# required for default WogiFlow operation; they enable specific features
# or are set automatically by the harness. Variables prefixed with WOGI_
# / WOGIFLOW_ are owned by WogiFlow itself; the others are conventional
# Claude Code / provider / system variables that WogiFlow reads.
#
# Last sync: 2026-04-26 (audit finding td-f11)

# ─── LLM Provider Credentials ─────────────────────────────────────
# Used by hybrid mode, peer review, and IGR adversary classifiers.
# Pick the providers you actually use; unset variables are skipped
# (features degrade to skip-with-warning).
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Override the default Claude model used by WogiFlow's adapters.
# Empty → use the model selected by config.models.adapter.
# CLAUDE_MODEL=

# ─── Claude Code (CLI harness) ────────────────────────────────────
# Disable the 1M-context window even on supported plans (rare; cost control).
# CLAUDE_CODE_DISABLE_1M_CONTEXT=

# Session IDs injected by Claude Code on launch. WogiFlow reads them to
# associate state with the active session; do NOT set manually.
# CLAUDE_CODE_SESSION_ID=
# CLAUDE_SESSION_ID=

# Disable WogiFlow enforcement (hooks, MCP, CLAUDE.md). Used for
# sandboxed experiments. WogiFlow surfaces a session-start warning.
# CLAUDE_CODE_SIMPLE=

# ─── Debug / Verbosity ────────────────────────────────────────────
# Generic debug switches read by hooks + scripts (any non-empty value enables).
# DEBUG=1
# WOGIFLOW_DEBUG=1
# WOGI_DEBUG_BOOT=1
# DEBUG_HYBRID=1
# DEBUG_LSP=1
# WOGIFLOW_VERBOSE=1
# VERBOSE_CONFIG=1

# Disable colorized output (CI, log files).
# NO_COLOR=1

# ─── Workspace Manager + Worker Mode ──────────────────────────────
# Set by `wogi workspace` orchestration. Workers MUST NOT modify these.
# Path-discipline gate enforces ownership across the manager/worker
# boundary (Story B / wf-ab59f0e4).
# WOGI_WORKSPACE_ROOT=
# WOGI_REPO_NAME=
# WOGI_MANAGER_PORT=8800
# WOGI_CHANNEL_PORT=
# WOGI_PEERS=

# ─── Internal (set by hooks; do NOT set manually) ─────────────────
# WOGI_PROJECT_ROOT=
# WOGIFLOW_PROJECT_ROOT=
# WOGIFLOW_PACKAGE_ROOT=
# WOGI_SESSION_ID=
# WOGI_TASK_ID=
# WOGI_DETECT_MESSAGE=
# WOGI_DETECT_TASK_ID=
# WOGI_EFFORT_LEVEL=
# WOGI_MCP_MODE=
# WOGI_RESTART_FLAG=
# WOGI_WRAPPER_PID=
# AI_SESSION_ID=

# ─── Postinstall / CI Behavior ────────────────────────────────────
# Skip the postinstall script (e.g. for CI snapshots).
# WOGIFLOW_SKIP_POSTINSTALL=1
# Suppress uninstall-time logs.
# WOGIFLOW_SILENT_UNINSTALL=1
# Force regeneration of generated files (CLAUDE.md, AGENTS.md).
# WOGIFLOW_FORCE_REGEN=1
# WOGIFLOW_REGEN_TIMEOUT=
# Strict task-ID validation (tests).
# WOGIFLOW_STRICT_IDS=1

# ─── Misc / System ────────────────────────────────────────────────
# Conventional system variables WogiFlow reads but does not own.
# NODE_ENV=production
# CI=

# Scratch / one-off scripts.
# API_URL=
# DETECTED_FRAMEWORK=
# FORMAT=
# MODEL=
# SCAN_PATH=
# TOKENS=
# VALIDATE_CONFIG=
