{
  "name": "navigation-test",
  "description": "Test main navigation links work correctly",
  "created": "2026-02-08",
  "tags": ["#e2e", "#navigation"],
  "baseUrl": "http://localhost:3000",
  "note": "Change baseUrl to match your project's dev server",
  "steps": [
    {
      "action": "navigate",
      "url": "/",
      "description": "Start at home page"
    },
    {
      "action": "wait",
      "selector": "nav, [role=navigation], header",
      "timeout": 10000,
      "description": "Wait for navigation to render"
    },
    {
      "action": "screenshot",
      "name": "nav-initial",
      "description": "Capture initial navigation state"
    },
    {
      "action": "click",
      "selector": "nav a:first-of-type, [role=navigation] a:first-of-type, header a:first-of-type, .navbar a:first-of-type",
      "description": "Click first navigation link (broad selector with fallbacks)"
    },
    {
      "action": "wait",
      "selector": "body",
      "timeout": 5000,
      "description": "Wait for page transition"
    },
    {
      "action": "screenshot",
      "name": "nav-after-click",
      "description": "Capture state after navigation click"
    },
    {
      "action": "verify",
      "selector": "body",
      "exists": true,
      "description": "Verify page rendered after navigation"
    }
  ],
  "expectedResult": "Navigation links are clickable and pages render without errors"
}
