{
  "$schema": "./config.schema.json",
  "version": "2.0.0",
  "projectName": "wogi-flow",
  "cli": {
    "type": "claude-code"
  },
  "enforcement": {
    "strictMode": true,
    "taskGating": { "enabled": false },
    "scopeGating": { "enabled": false },
    "implementationGate": { "enabled": false },
    "todoWriteGate": { "enabled": false },
    "routingGate": { "enabled": false },
    "loopEnforcement": { "enabled": false }
  },
  "componentReuse": {
    "enabled": false
  },
  "skills": {
    "installed": ["figma-analyzer"]
  },
  "hooks": {
    "enabled": false,
    "rules": {
      "intelligence": {
        "sessionContext": { "enabled": false },
        "validation": { "enabled": false }
      },
      "lifecycle": {
        "taskCompleted": { "enabled": false },
        "setup": { "enabled": false }
      }
    }
  },
  "plugins": {
    "_comment_phaseInjection": "When true, the UserPromptSubmit hook appends available flow-integrated plugin hints to the phase context prompt",
    "_comment_standaloneBypassTask": "When true, standalone-mode plugin matches in /wogi-start skip task creation and invoke the plugin directly"
  }
}
