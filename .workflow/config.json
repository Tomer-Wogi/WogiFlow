{
  "$schema": "./config.schema.json",
  "version": "2.0.0",
  "projectName": "wogi-flow",
  "cli": {
    "type": "claude-code",
    "autoSync": {
      "enabled": false,
      "onSessionStart": true
    }
  },
  "autoLog": true,
  "autoUpdateAppMap": true,
  "_comment_scripts": "Script name overrides. null = auto-detect from package.json. Set to a string to override (e.g., \"npm run type-check\").",
  "scripts": {
    "lint": null,
    "typecheck": null,
    "test": null,
    "build": null,
    "fix": null,
    "coverage": null
  },
  "requireApproval": [],
  "enforcement": {
    "strictMode": true,
    "requireTaskForImplementation": true,
    "requireStoryForMediumTasks": true,
    "requirePatternCitation": false,
    "citationFormat": "// Pattern: {pattern}",
    "blockAutoTask": true,
    "warnOnBypass": true,
    "taskSizeThresholds": {
      "small": {
        "maxFiles": 3,
        "maxHours": 1
      },
      "medium": {
        "maxFiles": 10,
        "maxHours": 4
      },
      "large": {
        "minFiles": 10,
        "minHours": 4
      }
    }
  },
  "_comment_tasks_vs_loops": "tasks = script-level config (flow-start.js). loops = AI-level loop enforcement. Shared keys (maxIterations, maxRetries, blockExitUntilComplete, autoInferVerification) must stay in sync.",
  "tasks": {
    "maxIterations": 20,
    "stuckThreshold": 3,
    "progressCommitInterval": 3,
    "recheckAfterFix": true,
    "blockExitUntilComplete": true,
    "autoInferVerification": true,
    "maxRetries": 5,
    "requireSpecVerification": true,
    "specVerification": {
      "validateSyntax": true,
      "allowSkipWithFlag": true,
      "parsePatterns": [
        "tables",
        "code-blocks",
        "lists"
      ]
    }
  },
  "errorRecovery": {
    "enabled": false,
    "hierarchicalAnalysis": true,
    "autoSuggestFixes": true,
    "trackSuccessfulStrategies": true,
    "maxAttemptsPerLevel": 3,
    "architecturalReassessment": {
      "enabled": false,
      "strikeCount": 3,
      "autoResearch": true,
      "requireApproval": true
    },
    "recursive": {
      "enabled": false,
      "maxDepth": 3,
      "maxHypotheses": 5,
      "timeout": 300000
    },
    "hypothesisGeneration": {
      "usePatterns": true,
      "useAI": false,
      "aiModel": "haiku"
    },
    "learning": {
      "recordSuccessfulFixes": true,
      "recordFailedHypotheses": true
    }
  },
  "workflow": {
    "planningStyle": "feature-based",
    "agentStructure": "unified"
  },
  "loops": {
    "enabled": false,
    "enforced": true,
    "blockExitUntilComplete": true,
    "requireVerification": true,
    "blockOnSkip": true,
    "maxRetries": 5,
    "maxIterations": 20,
    "commitEvery": 3,
    "pauseBetweenScenarios": false,
    "autoInferVerification": true,
    "fallbackToManual": true,
    "simpleMode": {
      "enabled": false,
      "completionPromise": "TASK_COMPLETE",
      "maxIterations": 10
    },
    "recheckAllAfterFix": true,
    "regressionOnRecheck": "warn"
  },
  "taskQueue": {
    "enabled": false,
    "autoContinue": true,
    "pauseBetweenTasks": false,
    "maxQueueSize": 10,
    "showProgressSummary": true
  },
  "durableSteps": {
    "enabled": false,
    "autoResume": true,
    "checkSuspensionsOnStart": true,
    "defaultMaxAttempts": 5
  },
  "suspension": {
    "enabled": false,
    "pollIntervalSeconds": 60,
    "maxPollAttempts": 120,
    "reminderAfterHours": 24
  },
  "parallel": {
    "enabled": false,
    "maxConcurrent": 3,
    "autoApprove": false,
    "requireWorktree": true,
    "showProgress": true,
    "autoDetect": true,
    "autoSuggest": true,
    "autoExecute": false,
    "minTasksForParallel": 2
  },
  "bulkOrchestrator": {
    "enabled": false,
    "parallelLimit": 3,
    "useWorktrees": true,
    "onFailure": "stop-dependent",
    "summaryDepth": "standard",
    "continuous": {
      "enabled": false,
      "idleAction": "stop",
      "idleTimeout": 60,
      "maxIdleChecks": 3
    }
  },
  "capture": {
    "autoGroup": true,
    "groupingThreshold": 0.5,
    "maxGroupSize": 5,
    "routing": {
      "enabled": false,
      "defaultCertainty": "certain",
      "autoDetect": true
    }
  },
  "phases": {
    "enabled": false,
    "autoSuggestForStories": true,
    "definitions": [
      {
        "id": "contract",
        "name": "Contract",
        "description": "Define interfaces, types, API contracts",
        "focus": [
          "types",
          "interfaces",
          "contracts"
        ],
        "output": "Type definitions and API contracts"
      },
      {
        "id": "skeleton",
        "name": "Skeleton",
        "description": "Create file structure, stub implementations",
        "focus": [
          "structure",
          "stubs",
          "scaffolding"
        ],
        "output": "File structure with stub implementations"
      },
      {
        "id": "core",
        "name": "Core Logic",
        "description": "Implement main business logic",
        "focus": [
          "logic",
          "implementation",
          "happy-path"
        ],
        "output": "Working happy-path implementation"
      },
      {
        "id": "edge-cases",
        "name": "Edge Cases",
        "description": "Handle edge cases and error states",
        "focus": [
          "errors",
          "edge-cases",
          "validation"
        ],
        "output": "Robust error handling"
      },
      {
        "id": "polish",
        "name": "Polish",
        "description": "Optimization, cleanup, documentation",
        "focus": [
          "optimization",
          "cleanup",
          "docs"
        ],
        "output": "Production-ready code"
      }
    ]
  },
  "mandatorySteps": {
    "afterTask": [],
    "beforeCommit": [],
    "onSessionEnd": [
      "updateRequestLog",
      "updateAppMap"
    ]
  },
  "priorities": {
    "defaultPriority": "P2",
    "autoBoostDays": 2,
    "autoBoostAmount": 1,
    "levels": {
      "P0": {
        "label": "Critical",
        "description": "Drop everything"
      },
      "P1": {
        "label": "High",
        "description": "Do today"
      },
      "P2": {
        "label": "Medium",
        "description": "Do this week"
      },
      "P3": {
        "label": "Low",
        "description": "Do when possible"
      },
      "P4": {
        "label": "Backlog",
        "description": "Someday"
      }
    }
  },
  "storyDecomposition": {
    "autoDetect": true,
    "autoDecompose": false,
    "complexityThreshold": "medium",
    "minSubTasks": 5,
    "edgeCases": true,
    "loadingStates": true,
    "errorStates": true,
    "classification": {
      "enabled": false,
      "autoClassify": true,
      "warnOnMismatch": true,
      "thresholds": {
        "epic": {
          "minFiles": 15,
          "minStories": 3
        },
        "story": {
          "minFiles": 5,
          "maxFiles": 15,
          "minCriteria": 3
        },
        "task": {
          "minFiles": 1,
          "maxFiles": 5,
          "minCriteria": 1
        }
      },
      "keywords": {
        "epic": [
          "system",
          "architecture",
          "migration",
          "redesign",
          "platform",
          "infrastructure",
          "overhaul"
        ],
        "story": [
          "feature",
          "flow",
          "integration",
          "module",
          "workflow",
          "implement"
        ],
        "task": [
          "add",
          "fix",
          "update",
          "change",
          "remove",
          "button",
          "field",
          "tweak"
        ]
      }
    },
    "supportEpics": true,
    "propagateProgress": true
  },
  "epics": {
    "enabled": false,
    "autoUpdateProgress": true,
    "showInReady": true,
    "progressWeights": {
      "completed": 1,
      "inProgress": 0.5,
      "ready": 0,
      "blocked": 0
    }
  },
  "clarifyingQuestions": {
    "enabled": false,
    "maxQuestions": 5,
    "skipForSmallTasks": true,
    "smallTaskThreshold": 2
  },
  "specificationMode": {
    "enabled": false,
    "mandatory": true,
    "mandatoryFor": [
      "medium",
      "large"
    ],
    "skipFor": [
      "small",
      "bugfix"
    ],
    "requireApproval": true,
    "specDirectory": ".workflow/specs",
    "template": "default",
    "sections": {
      "acceptanceCriteria": true,
      "implementationSteps": true,
      "filesToChange": true,
      "testStrategy": true,
      "verificationCommands": true,
      "rollbackPlan": false
    },
    "autoDetectFiles": true,
    "autoSuggestTests": true,
    "needsClarification": {
      "enabled": false,
      "_comment_needsClarification": "Force spec generation to mark uncertain points with [NEEDS CLARIFICATION: reason]. Implementation is blocked until all markers are resolved.",
      "markerFormat": "[NEEDS CLARIFICATION: {reason}]",
      "blockImplementation": true,
      "minMarkersForReview": 0,
      "categories": [
        "assumption",
        "ambiguity",
        "missing-context",
        "dependency-unknown",
        "edge-case"
      ]
    }
  },
  "qualityGates": {
    "preTaskBaseline": {
      "enabled": false,
      "failureThreshold": 5,
      "skipForTypes": [
        "bugfix",
        "quick-fix"
      ],
      "command": null
    },
    "feature": {
      "require": [
        "loopComplete",
        "tests",
        "appMapUpdate",
        "requestLogEntry",
        "integrationWiring",
        "standardsCompliance"
      ],
      "optional": [
        "review",
        "docs",
        "webmcpVerification"
      ]
    },
    "bugfix": {
      "require": [
        "loopComplete",
        "tests",
        "requestLogEntry",
        "standardsCompliance",
        "learningEnforcement",
        "resolutionPopulated"
      ],
      "optional": [
        "review",
        "webmcpVerification"
      ]
    },
    "refactor": {
      "require": [
        "loopComplete",
        "tests",
        "noNewFeatures",
        "smokeTest",
        "standardsCompliance"
      ],
      "optional": [
        "review",
        "webmcpVerification"
      ]
    }
  },
  "standardsCompliance": {
    "enabled": false,
    "mode": "block",
    "scopeByTaskType": true,
    "alwaysCheck": [
      "naming",
      "security"
    ],
    "similarityThreshold": 0.8,
    "_comment_similarityThreshold": "Legacy — prefer semanticMatching.thresholds. Kept for backward compatibility.",
    "similarityWarningThreshold": 0.6,
    "learning": {
      "enabled": false,
      "promotionThreshold": 3,
      "includePreventionPrompts": true,
      "autoSyncRules": true
    }
  },
  "validation": {
    "_comment_afterFileEdit": "Hook-based auto-validation is disabled. CLAUDE.md instructs AI to self-validate. Enable for hook-enforced validation.",
    "afterFileEdit": {
      "enabled": false,
      "_comment_commands": "Commands per file extension. Use actual commands or null to auto-detect via flow-script-resolver.js at runtime.",
      "commands": {
        "*.ts": [
          "npx tsc --noEmit"
        ],
        "*.tsx": [
          "npx tsc --noEmit",
          "npx eslint {file} --fix"
        ],
        "*.js": [
          "npx eslint {file} --fix"
        ],
        "*.jsx": [
          "npx eslint {file} --fix"
        ]
      },
      "fixErrorsBeforeContinuing": true
    },
    "_comment_afterTaskComplete": "Commands run after task completion. These are disabled by default. When enabled, flow-script-resolver.js resolves commands at runtime.",
    "afterTaskComplete": {
      "enabled": false,
      "commands": [
        "npm run lint",
        "npm run typecheck"
      ]
    },
    "beforeCommit": {
      "enabled": false,
      "commands": [
        "npm run lint",
        "npm run typecheck",
        "npm test"
      ]
    }
  },
  "checkpoint": {
    "enabled": false,
    "onTaskComplete": true,
    "maxCheckpoints": 20,
    "autoCommit": false,
    "commitPrefix": "[checkpoint]",
    "includeStateFiles": true
  },
  "regressionTesting": {
    "enabled": false,
    "sampleSize": 3,
    "runOnTaskComplete": true,
    "onFailure": "warn"
  },
  "componentRules": {
    "preferVariants": true,
    "requireAppMapEntry": true,
    "requireDetailDoc": false,
    "autoGenerateStorybook": false,
    "storybookPath": "src/stories"
  },
  "_comment_strictMode_collision": "This 'strictMode' controls verification checklists. NOT the same as enforcement.strictMode (task gating) or research.strictMode (citation rules). Three distinct features share the key name.",
  "strictMode": {
    "verificationChecklist": false,
    "correctionReportsOnFail": false,
    "featureReportsOnComplete": false
  },
  "skills": {
    "installed": [
      "figma-analyzer"
    ],
    "comingSoon": [],
    "autoInvoke": true,
    "autoDiscoverNested": true,
    "minRelevanceScore": 2,
    "_comment_minRelevanceScore": "Replaced maxSkillsPerTask: 3. All skills scoring above this threshold are loaded, no arbitrary cap.",
    "autoFetchDocs": true,
    "_comment_autoFetchDocs": "Auto-fetch library documentation via Context7 MCP during onboarding/rescan.",
    "contentPriority": ["skill.md", "conventions.md", "anti-patterns.md", "learnings.md", "library-reference.md"],
    "_comment_contentPriority": "Loading order for skill content layers. Last item (library-reference.md) is first to trim if token budget tight.",
    "loadPatterns": true,
    "loadAntiPatterns": true,
    "loadLearnings": true,
    "loadLibraryReference": true,
    "loadConventions": true
  },
  "skillLearning": {
    "enabled": false,
    "autoExtract": true,
    "triggers": {
      "onCommit": true,
      "onTaskComplete": true,
      "onCompact": true
    },
    "minCorrectionsToLearn": 1,
    "autoCreateSkills": "ask",
    "autoDetectFrameworks": true,
    "fetchOfficialDocs": true,
    "frameworkDetectionPatterns": {
      "nestjs": [
        "*.module.ts",
        "*.controller.ts",
        "*.service.ts",
        "@nestjs/*"
      ],
      "react": [
        "*.tsx",
        "*.jsx",
        "use*.ts",
        "react",
        "react-dom"
      ],
      "vue": [
        "*.vue",
        "vue",
        "@vue/*"
      ],
      "angular": [
        "*.component.ts",
        "*.module.ts",
        "@angular/*"
      ],
      "fastapi": [
        "main.py",
        "fastapi",
        "pydantic"
      ],
      "django": [
        "manage.py",
        "django",
        "settings.py"
      ],
      "express": [
        "app.js",
        "express",
        "router.js"
      ]
    },
    "officialDocsUrls": {
      "nestjs": "https://docs.nestjs.com",
      "react": "https://react.dev",
      "vue": "https://vuejs.org/guide",
      "angular": "https://angular.io/docs",
      "fastapi": "https://fastapi.tiangolo.com",
      "django": "https://docs.djangoproject.com",
      "express": "https://expressjs.com/en/guide"
    },
    "learnFromLoopRetries": true,
    "loopRetryThreshold": 3,
    "autoSuggestPatternUpdates": true
  },
  "sessionLearning": {
    "enabled": false,
    "autoApplyThreshold": 90,
    "minOccurrences": 2,
    "confidenceThreshold": 70,
    "scope": "today",
    "analyzeReviews": true,
    "analyzeRetries": true,
    "analyzeFixes": true
  },
  "bugFlow": {
    "investigationAgents": {
      "errorSourceFinder": { "enabled": false },
      "patternChecker": { "enabled": false },
      "dependencyAnalyzer": { "enabled": false, "minSeverity": "high" }
    },
    "autoRoute": true,
    "learningEnforcement": {
      "enabled": false,
      "requireResolution": true,
      "requireFeedbackPattern": true,
      "promotionThreshold": 3
    },
    "inlineDiscovery": {
      "maxSearchOperations": 3,
      "maxFileReads": 2,
      "autoPriorityBoost": true,
      "skipDependencyAnalysis": true
    },
    "severityOverride": {
      "enabled": false,
      "requireJustification": true
    }
  },
  "crossSessionLearning": {
    "enabled": false,
    "lookbackDays": 30,
    "minOccurrences": 3,
    "similarityThreshold": 0.5,
    "autoPromptOnSessionEnd": true,
    "saveTo": "both"
  },
  "_comment_promotionPaths": "Three paths promote patterns to decisions.md: (1) autoLearning/automaticPromotion — auto from bug/review pipeline, (2) crossSessionLearning — on session-end, (3) /wogi-learn — manual interactive. All share the canonical promotionThreshold from autoLearning.promotionThreshold (default: 3).",
  "decide": {
    "requireRationale": true,
    "scanForViolations": true,
    "maxClarifyingQuestions": 4,
    "violationRouting": {
      "_comment": "Severity thresholds for routing violations found during /wogi-decide scans",
      "quickFixThreshold": 3,
      "storyThreshold": 10,
      "epicThreshold": 25
    }
  },
  "learning": {
    "_comment": "Used by /wogi-learn. promotionThreshold reads from autoLearning.promotionThreshold for consistency.",
    "autoPromoteEnabled": false,
    "requireUserConfirmation": true
  },
  "retrospective": {
    "maxQuestions": 3,
    "autoSuggestRules": true,
    "saveReviewFile": true,
    "quickModeDefault": false
  },
  "memory": {
    "enabled": false,
    "localDb": ".workflow/memory/local.db",
    "embeddingModel": "Xenova/all-MiniLM-L6-v2",
    "maxLocalFacts": 1000,
    "autoRemember": false
  },
  "automaticMemory": {
    "enabled": false,
    "entropyThreshold": 0.7,
    "compactOnSessionEnd": true,
    "relevanceDecay": {
      "enabled": false,
      "decayRate": 0.033,
      "neverAccessedPenalty": 0.1
    },
    "demotion": {
      "relevanceThreshold": 0.3,
      "coldRetentionDays": 90
    },
    "selfTuning": {
      "enabled": false,
      "adjustOnOverflow": true,
      "adjustOnFailures": true
    },
    "observationCapture": {
      "enabled": false,
      "skipTools": [],
      "maxInputSize": 2000,
      "maxOutputSize": 2000,
      "_comment_retentionDays": "Also defines the extraction window for observationExtraction below",
      "retentionDays": 30
    },
    "observationExtraction": {
      "enabled": false,
      "minDurationMs": 100,
      "excludeTools": ["Read", "Glob", "Grep"]
    }
  },
  "automaticPromotion": {
    "enabled": false,
    "threshold": 3,
    "minRelevance": 0.8,
    "destinations": [
      "decisions.md"
    ],
    "requireApproval": true
  },
  "knowledgeRouting": {
    "autoDetect": true,
    "confirmWithUser": true,
    "defaultScope": "local",
    "modelSpecificLearning": true
  },
  "modelAdapters": {
    "enabled": false,
    "autoLearn": true,
    "directory": ".workflow/model-adapters"
  },
  "prd": {
    "enabled": false,
    "maxContextTokens": 2000,
    "chunkSize": 500,
    "autoRetrieve": false
  },
  "context": {
    "compaction": {
      "enabled": false,
      "thresholds": {
        "warnAt": 50000,
        "compactAt": 80000,
        "maxExpanded": 20000
      },
      "summary": {
        "rootMaxLength": 200,
        "sectionMaxLength": 500,
        "detailMaxLength": 1000
      },
      "relevanceDecay": {
        "enabled": false,
        "decayPerTurn": 0.05
      },
      "autoCleanup": true,
      "savePath": ".workflow/state/context-tree.json"
    }
  },
  "smartCompaction": {
    "enabled": true,
    "safeThreshold": 0.95,
    "emergencyThreshold": 0.9,
    "estimation": {
      "perFile": 0.02,
      "perCriterion": 0.03,
      "perSpecChars": 0.002,
      "refactorBuffer": 0.1,
      "defaultSmallTask": 0.1,
      "defaultMediumTask": 0.25,
      "defaultLargeTask": 0.4
    },
    "refactorKeywords": [
      "refactor",
      "migration",
      "overhaul",
      "redesign",
      "rewrite",
      "restructure",
      "rearchitect"
    ]
  },
  "autoContext": {
    "enabled": false,
    "strategy": "dynamic",
    "showLoadedFiles": true,
    "includeContent": true,
    "useSectionReferences": true,
    "maxFilesToLoad": 10,
    "maxGrepResults": 10,
    "maxComponentMatches": 15,
    "maxContentLines": 50,
    "useAstGrep": false,
    "maxSemanticFacts": 5,
    "semanticMinRelevance": 40,
    "fallbackLimits": {
      "maxFilesHard": 50,
      "maxTokensHard": 150000
    },
    "lspEnrichment": {
      "enabled": false,
      "maxFiles": 5,
      "timeoutMs": 5000,
      "showExports": true,
      "showDiagnostics": true,
      "prioritizeHealthyFiles": true
    }
  },
  "sessionState": {
    "enabled": false,
    "autoRestore": true,
    "maxGapHours": 24,
    "trackFiles": true,
    "trackDecisions": true,
    "maxRecentFiles": 20,
    "maxRecentDecisions": 10
  },
  "contextMonitor": {
    "enabled": false,
    "warnAt": 0.7,
    "criticalAt": 0.85,
    "contextWindow": 200000,
    "checkOnSessionStart": true,
    "checkAfterTask": true
  },
  "morningBriefing": {
    "enabled": false,
    "showLastSession": true,
    "showChanges": true,
    "showRecommendedTasks": 3,
    "generatePrompt": true,
    "showBlockers": true,
    "showKeyContext": true,
    "showTechDebt": true,
    "checkKnowledgeSync": true,
    "autoRegenerateKnowledge": true,
    "showRuleViolations": true,
    "_comment_showRuleViolations": "Show deferred rule violations from /wogi-decide scans",
    "showAutoPromotedRules": true,
    "_comment_showAutoPromotedRules": "Show rules auto-promoted from feedback-patterns since last briefing"
  },
  "bulkLoop": {
    "enabled": false,
    "maxIterations": 100,
    "pollInterval": 10,
    "errorThreshold": 3,
    "contextThreshold": 0.8,
    "taskTimeout": 1800
  },
  "techDebt": {
    "enabled": false,
    "promptOnSessionEnd": true,
    "showInMorningBriefing": true,
    "agingThreshold": 3,
    "autoFix": {
      "enabled": false,
      "types": [
        "console.log",
        "unused-import",
        "debugger",
        "empty-catch"
      ]
    },
    "debtBudget": {
      "enabled": false,
      "maxOpenItems": 20
    }
  },
  "requestLog": {
    "enabled": false,
    "autoArchive": true,
    "maxRecentEntries": 50,
    "keepRecent": 30,
    "createSummary": true
  },
  "componentIndex": {
    "autoScan": true,
    "scanOn": [
      "sessionStart",
      "afterTask",
      "preCommit"
    ],
    "staleAfterMinutes": 60,
    "directories": [
      "src/components",
      "src/hooks",
      "src/services",
      "src/pages",
      "src/modules",
      "app"
    ],
    "ignore": [
      "*.test.*",
      "*.spec.*",
      "*.stories.*",
      "index.ts",
      "index.js",
      "__tests__",
      "__mocks__"
    ]
  },
  "functionRegistry": {
    "enabled": false,
    "directories": [
      "src/utils",
      "src/lib",
      "src/helpers"
    ],
    "scanOn": [
      "sessionStart",
      "afterTask"
    ],
    "autoUpdate": true
  },
  "apiRegistry": {
    "enabled": false,
    "directories": [
      "src/api",
      "src/services"
    ],
    "scanOn": [
