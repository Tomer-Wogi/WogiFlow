{
  "$schema": "./registry-schema.json",
  "version": "1.0.0",
  "lastUpdated": "2026-03-10T12:00:00.000Z",

  "providers": {
    "anthropic": {
      "name": "Anthropic",
      "apiEndpoint": "https://api.anthropic.com/v1",
      "apiKeyEnv": "{env:ANTHROPIC_API_KEY}",
      "supportedFeatures": ["streaming", "tool-use", "vision", "extended-thinking", "adaptive-thinking"],
      "rateLimit": {
        "requestsPerMinute": 60,
        "tokensPerMinute": 100000
      },
      "cli": {
        "name": "Claude Code",
        "cliId": "claude-code",
        "folderStructure": {
          "configDir": ".claude",
          "skillsDir": ".claude/skills",
          "rulesDir": ".claude/rules",
          "commandsDir": ".claude/commands",
          "docsDir": ".claude/docs"
        },
        "rulesFile": "CLAUDE.md",
        "promptStyle": "xml-tags",
        "hotReload": true,
        "features": ["skills", "rules", "commands", "hooks"]
      }
    },
    "openai": {
      "name": "OpenAI",
      "apiEndpoint": "https://api.openai.com/v1",
      "apiKeyEnv": "{env:OPENAI_API_KEY}",
      "supportedFeatures": ["streaming", "tool-use", "vision", "function-calling"],
      "rateLimit": {
        "requestsPerMinute": 60,
        "tokensPerMinute": 90000
      },
      "cli": null
    },
    "google": {
      "name": "Google AI",
      "apiEndpoint": "https://generativelanguage.googleapis.com/v1",
      "apiKeyEnv": "{env:GOOGLE_API_KEY}",
      "supportedFeatures": ["streaming", "tool-use", "vision"],
      "rateLimit": {
        "requestsPerMinute": 60,
        "tokensPerMinute": 100000
      },
      "cli": null
    },
    "ollama": {
      "name": "Ollama (Local)",
      "apiEndpoint": "http://localhost:11434/api",
      "apiKeyEnv": null,
      "supportedFeatures": ["streaming"],
      "rateLimit": null,
      "cli": null
    }
  },

