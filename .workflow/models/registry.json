  "capabilities": {
    "code-gen": {
      "description": "Generate new code from requirements",
      "requiredFor": ["feature", "component"]
    },
    "reasoning": {
      "description": "Complex multi-step reasoning and planning",
      "requiredFor": ["architecture", "debugging"]
    },
    "analysis": {
      "description": "Analyze existing code and provide insights",
      "requiredFor": ["review", "refactor"]
    },
    "structured-output": {
      "description": "Generate well-formatted JSON/structured data",
      "requiredFor": ["schema", "config"]
    },
    "vision": {
      "description": "Process and understand images",
      "requiredFor": ["ui-from-design", "screenshot-analysis"]
    },
    "extended-thinking": {
      "description": "Extended reasoning with visible thought process",
      "requiredFor": ["complex-architecture", "difficult-bugs"]
    },
    "adaptive-thinking": {
      "description": "Adaptive reasoning with effort levels (low, medium, high, max)",
      "requiredFor": ["complex-architecture", "difficult-bugs", "sustained-agentic"]
    }
  },

  "costTiers": {
    "economy": {
      "description": "Low-cost models for simple tasks",
      "maxCostPerTask": 0.05,
      "preferredModels": ["claude-haiku-3-5", "gemini-2-flash"]
    },
    "standard": {
      "description": "Balanced cost/capability for most tasks",
      "maxCostPerTask": 0.50,
      "preferredModels": ["claude-sonnet-4-6", "claude-sonnet-4", "gpt-4o"]
    },
    "premium": {
      "description": "High-capability models for complex tasks",
      "maxCostPerTask": 5.00,
      "preferredModels": ["claude-opus-4-6", "claude-opus-4-5"]
    }
  },

  "routing": {
    "default": {
      "primary": "claude-sonnet-4-6",
      "fallback": "claude-sonnet-4",
      "escalation": "claude-opus-4-6"
    },
    "byTaskType": {
      "feature": { "primary": "claude-sonnet-4-6" },
      "bugfix": { "primary": "claude-sonnet-4-6" },
      "refactor": { "primary": "claude-sonnet-4-6" },
      "architecture": { "primary": "claude-opus-4-6" },
      "quick-edit": { "primary": "claude-haiku-3-5" },
      "documentation": { "primary": "claude-haiku-3-5" }
    },
    "byLanguage": {
      "typescript": { "primary": "claude-sonnet-4-6" },
      "python": { "primary": "gpt-4o", "fallback": "claude-sonnet-4" }
    }
  }
}
