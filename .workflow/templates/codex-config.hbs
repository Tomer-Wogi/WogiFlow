# WogiFlow Codex Configuration
# Generated: {{timestamp}}
# Project: {{projectName}}

# ============================================================
# Approval Settings
# ============================================================
# WogiFlow recommends "on-request" for safer operation
# Change to "auto" if you prefer more autonomy

[approvals]
mode = "on-request"

# ============================================================
# MCP Servers
# ============================================================
# WogiFlow memory server for persistent facts/learnings

[mcp_servers.wogiflow_memory]
command = "node"
args = ["mcp-memory-server/index.js"]
cwd = "{{projectRoot}}"

# ============================================================
# Features
# ============================================================

[features]
# Allow nested AGENTS.md files for directory-specific instructions
child_agents_md = true

# ============================================================
# Project Documentation
# ============================================================
# Recognize WogiFlow documentation files as agent instructions

project_doc_fallback_filenames = [
  "CLAUDE.md",
  "GEMINI.md",
  ".workflow/README.md"
]

# Maximum size for project docs (default 65536)
project_doc_max_bytes = 65536

# ============================================================
# Additional MCP Servers (Uncomment to enable)
# ============================================================

# Context7 for up-to-date library documentation
# [mcp_servers.context7]
# command = "npx"
# args = ["-y", "@context7/mcp-server"]

# Playwright for browser automation
# [mcp_servers.playwright]
# command = "npx"
# args = ["-y", "@anthropic/playwright-mcp"]

# ============================================================
# Notifications (Uncomment to enable)
# ============================================================
# Codex only supports "agent-turn-complete" event

# Mac sound notification
# notify = ["bash", "-lc", "afplay /System/Library/Sounds/Blow.aiff"]

# Custom script notification
# notify = ["node", "{{projectRoot}}/scripts/flow-notify.js"]
