  "presets": {
    "strict": {
      "description": "Maximum enforcement — all gates, all checks",
      "aliases": ["make it strict", "strict mode", "maximum enforcement", "be strict", "make it stricter"],
      "sets": {
        "enforcement.strictMode": true,
        "enforcement.requireTaskForImplementation": true,
        "enforcement.requireStoryForMediumTasks": true,
        "enforcement.taskGating.enabled": true,
        "enforcement.scopeGating.enabled": true,
        "enforcement.routingGate.enabled": true,
        "enforcement.loopEnforcement.enabled": true,
        "specificationMode.enabled": true
      }
    },
    "relaxed": {
      "description": "Minimal enforcement — faster iteration, fewer gates",
      "aliases": ["make it relaxed", "relax", "less strict", "ease up", "minimal enforcement", "loosen up"],
      "sets": {
        "enforcement.strictMode": false,
        "enforcement.requireTaskForImplementation": false,
        "enforcement.requireStoryForMediumTasks": false,
        "enforcement.taskGating.enabled": false,
        "enforcement.scopeGating.enabled": false,
        "enforcement.routingGate.enabled": false,
        "enforcement.loopEnforcement.enabled": false
      }
    },
    "fast": {
      "description": "Speed over thoroughness — minimal research, skip specs for small tasks",
      "aliases": ["fast mode", "speed", "quick", "minimal overhead", "less overhead", "go fast"],
      "sets": {
        "research.enabled": false,
        "research.planMode.explorePhase.enabled": false,
        "specificationMode.enabled": false,
        "enforcement.requireStoryForMediumTasks": false,
        "hooks.enabled": false
      }
    },
    "research-heavy": {
      "description": "Deep research before every task — all agents, thorough depth",
      "aliases": ["deep research", "thorough research", "research everything", "more research"],
      "sets": {
        "research.enabled": true,
        "research.planMode.explorePhase.enabled": true,
        "research.planMode.researchAgents.codebaseAnalyzer.enabled": true,
        "research.planMode.researchAgents.bestPractices.enabled": true,
        "research.planMode.researchAgents.versionVerifier.enabled": true,
        "research.planMode.researchAgents.riskHistory.enabled": true,
        "research.planMode.researchAgents.standardsPreview.enabled": true,
        "research.planMode.researchDepth": "thorough"
      }
    },
    "full-testing": {
      "description": "Complete testing suite — discovery, scenarios, all verification tiers",
      "aliases": ["full testing", "all tests", "maximum testing", "test everything"],
      "sets": {
        "testing.enabled": true,
        "testing.mode": "full",
        "testing.discovery.enabled": true,
        "testing.scenarios.enabled": true,
        "testing.generation.autoGenerate": true
      }
    },
    "tdd": {
      "description": "Test-driven development — write tests first, then implement",
      "aliases": ["test driven", "test first", "tdd mode"],
      "sets": {
        "testing.enabled": true,
        "execution.tdd.enforced": true,
        "execution.tdd.defaultForTypes": ["bugfix", "feature"]
      }
    },
    "parallel": {
      "description": "Enable parallel task execution with worktree isolation",
      "aliases": ["parallel execution", "run in parallel", "multi-task", "bulk processing"],
      "sets": {
        "parallelExecution.parallel.enabled": true,
        "parallelExecution.bulkOrchestrator.enabled": true,
        "parallelExecution.bulkOrchestrator.useWorktrees": true
      }
    }
  }
}
