      "aliases": ["bulk", "orchestrator", "bulk processing", "multi-task orchestrator", "batch tasks"],
      "configPath": "parallelExecution.bulkOrchestrator.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "parallelExecution.bulkOrchestrator.enabled": true
        },
        "prompts": [
          {
            "key": "parallelExecution.bulkOrchestrator.parallelLimit",
            "question": "Max parallel tasks? (1-5)",
            "default": "3"
          }
        ]
      }
    },
    "component-reuse": {
      "description": "Check for existing components before creating new ones",
      "aliases": ["reuse checking", "component check", "duplicate detection", "reuse detection", "similarity check"],
      "configPath": "componentReuse.enabled",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "componentReuse.enabled": true
        }
      }
    },
