        "prompts": [
          {
            "key": "execution.tdd.defaultForTypes",
            "question": "Which task types should use TDD? (comma-separated: bugfix, feature, refactor)",
            "default": "bugfix,feature"
          }
        ]
      }
    },
    "strict-mode": {
      "description": "Strict enforcement — require task routing for every message",
      "aliases": ["strict", "strict enforcement", "enforce tasks", "task gating"],
      "configPath": "enforcement.strictMode",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "enforcement.strictMode": true
        }
      }
    },
    "task-gating": {
      "description": "Block edits without an active task",
      "aliases": ["gate tasks", "require task", "block without task", "edit gating"],
      "configPath": "enforcement.taskGating.enabled",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "enforcement.taskGating.enabled": true
        }
      }
    },
    "scope-gating": {
      "description": "Warn when editing files outside task scope",
      "aliases": ["scope guard", "file scope", "scope warning", "scope enforcement"],
      "configPath": "enforcement.scopeGating.enabled",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "enforcement.scopeGating.enabled": true
        }
      }
    },
    "routing-gate": {
      "description": "Block tools until routed through /wogi-start",
      "aliases": ["routing", "route gate", "routing enforcement"],
      "configPath": "enforcement.routingGate.enabled",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "enforcement.routingGate.enabled": true
        }
      }
    },
    "loop-enforcement": {
      "description": "Require verification loop completion before closing tasks",
      "aliases": ["loops", "verification loops", "enforce loops", "loop gating"],
      "configPath": "enforcement.loopEnforcement.enabled",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "enforcement.loopEnforcement.enabled": true
        }
      }
    },
    "research": {
      "description": "Enable web research during the explore phase of task execution",
      "aliases": ["explore", "explore phase", "web research", "research phase", "enable research"],
      "configPath": "research.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "research.enabled": true
        },
        "prompts": [
          {
            "key": "research.planMode.researchDepth",
            "question": "Research depth? (thorough/standard/minimal)",
            "default": "thorough"
          }
        ]
      }
    },
    "research-agents": {
      "description": "Enable all research agents during explore phase",
      "aliases": ["all agents", "research agents", "enable agents", "codebase analyzer", "best practices agent"],
      "configPath": "research.planMode.researchAgents",
      "type": "object",
      "default": false,
      "dependencies": {
        "sets": {
          "research.enabled": true,
          "research.planMode.explorePhase.enabled": true,
          "research.planMode.researchAgents.codebaseAnalyzer.enabled": true,
          "research.planMode.researchAgents.bestPractices.enabled": true,
          "research.planMode.researchAgents.versionVerifier.enabled": true,
          "research.planMode.researchAgents.riskHistory.enabled": true,
          "research.planMode.researchAgents.standardsPreview.enabled": true
        }
      }
    },
    "parallel": {
      "description": "Enable parallel task execution with worktree isolation",
      "aliases": ["parallel execution", "run in parallel", "multi-task", "worktrees"],
      "configPath": "parallelExecution.parallel.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "parallelExecution.parallel.enabled": true
        }
      }
    },
