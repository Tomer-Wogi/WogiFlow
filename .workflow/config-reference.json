    },
    "project-has-api": {
      "description": "Override: tell WogiFlow this project has an API/backend",
      "aliases": ["has API", "has backend", "this project has API", "add API support", "enable API", "we have a backend", "this is a backend project", "this is an API project"],
      "configPath": "detection.overrides.hasAPI",
