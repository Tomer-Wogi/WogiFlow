      "description": "Security scanning before commits (secrets, injection, npm audit)",
      "aliases": ["security", "scan before commit", "secret scanning", "security check"],
      "configPath": "security.scanBeforeCommit",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "security.scanBeforeCommit": true,
          "security.blockOnHigh": true
        }
      }
    },
