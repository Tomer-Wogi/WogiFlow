      "aliases": ["session context", "context hook", "session intelligence"],
      "configPath": "hooks.rules.intelligence.sessionContext.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "hooks.enabled": true,
          "hooks.rules.intelligence.sessionContext.enabled": true
        }
      }
    },
    "validation-hook": {
      "description": "Post-edit validation hook — auto-lint/typecheck after edits",
      "aliases": ["auto validation", "validation hook", "post-edit validation", "auto lint"],
      "configPath": "hooks.rules.intelligence.validation.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "hooks.enabled": true,
          "hooks.rules.intelligence.validation.enabled": true
        }
      }
    },
    "task-completed-hook": {
      "description": "Task completed lifecycle hook — runs post-completion actions",
      "aliases": ["task completed", "completion hook", "post-task hook"],
      "configPath": "hooks.rules.lifecycle.taskCompleted.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "hooks.enabled": true,
          "hooks.rules.lifecycle.taskCompleted.enabled": true
        }
      }
    },
    "auto-log": {
      "description": "Automatically update request-log.md after changes",
      "aliases": ["request log", "auto logging", "automatic logging", "log changes"],
      "configPath": "autoLog",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "autoLog": true
        }
      }
    },
    "auto-update-app-map": {
      "description": "Automatically update app-map.md when components change",
      "aliases": ["app map", "auto app map", "component registry", "auto update map"],
      "configPath": "autoUpdateAppMap",
      "type": "boolean",
      "default": true,
      "dependencies": {
        "sets": {
          "autoUpdateAppMap": true
        }
      }
    },
    "webmcp": {
      "description": "WebMCP browser testing for UI verification",
      "aliases": ["browser testing", "web testing", "webmcp testing", "browser verification", "ui testing"],
      "configPath": "testing.webmcp.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "testing.enabled": true,
          "testing.webmcp.enabled": true
        }
      }
    },
    "review": {
      "description": "Code review settings — agents, finding thresholds, auto-review",
      "aliases": ["code review", "review settings", "auto review", "review agents"],
      "configPath": "review.agents.core",
      "type": "array",
      "default": ["code-logic", "security", "architecture"],
      "dependencies": {
        "sets": {}
      }
    },
    "specification-mode": {
      "description": "Require specification/plan approval before implementation",
      "aliases": ["specs", "spec mode", "planning", "require spec", "specification", "plan mode"],
      "configPath": "specificationMode.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "specificationMode.enabled": true
        }
      }
    },
