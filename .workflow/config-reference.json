{
  "version": 1,
  "features": {
    "testing": {
      "description": "Automated testing after task completion",
      "aliases": ["tests", "test", "auto-test", "run tests", "enable tests", "testing suite"],
      "configPath": "testing.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "testing.enabled": true
        },
        "prompts": [
          {
            "key": "testing.mode",
            "question": "What type of testing? (auto/ui/api/full/unit)",
            "default": "auto"
          }
        ]
      },
      "integrations": ["verification-profile"]
    },
    "test-discovery": {
      "description": "Auto-discover test scenarios from code and acceptance criteria",
      "aliases": ["discovery", "test discovery", "discover tests", "find tests"],
      "configPath": "testing.discovery.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "testing.enabled": true,
          "testing.discovery.enabled": true
        }
      }
    },
    "test-scenarios": {
      "description": "Generate test scenarios from acceptance criteria",
      "aliases": ["scenarios", "test scenarios", "generate scenarios"],
      "configPath": "testing.scenarios.enabled",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "testing.enabled": true,
          "testing.scenarios.enabled": true
        }
      }
    },
    "test-generation": {
      "description": "Auto-generate test files from scenarios",
      "aliases": ["generate tests", "auto generate tests", "test generation", "auto-gen tests"],
      "configPath": "testing.generation.autoGenerate",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "testing.enabled": true,
          "testing.generation.autoGenerate": true
        }
      }
    },
    "storybook": {
      "description": "Auto-generate Storybook stories when creating components",
      "aliases": ["stories", "component stories", "auto storybook", "storybook stories"],
      "configPath": "componentReuse.autoGenerateStorybook",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "componentReuse.autoGenerateStorybook": true
        }
      }
    },
    "tdd": {
      "description": "Test-driven development — write tests before implementation",
      "aliases": ["test driven", "test first", "tdd mode", "write tests first"],
      "configPath": "execution.tdd.enforced",
      "type": "boolean",
      "default": false,
      "dependencies": {
        "sets": {
          "testing.enabled": true,
          "execution.tdd.enforced": true
