# WogiFlow - .gitignore
# Excludes user-specific data so npm install gives a clean slate

# ===========================================
# OS & IDE files
# ===========================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# ===========================================
# Node.js
# ===========================================
node_modules/
mcp-memory-server/node_modules/

# ===========================================
# Temp files
# ===========================================
*.tmp
*.temp
*.log

# ===========================================
# Development artifacts (user-specific data)
# These are created from templates on npm install
# ===========================================

# State files
.workflow/state/ready.json
.workflow/state/request-log.md
.workflow/state/progress.md
.workflow/state/session-state.json
.workflow/state/knowledge-sync.json
# Legacy locations (deprecated in v1.0.4 - will be removed in v2.0)
.workflow/state/architecture.md
.workflow/state/stack.md
.workflow/state/testing.md

# New locations (v1.0.4+)
.workflow/specs/architecture.md
.workflow/specs/stack.md
.workflow/specs/testing.md
.workflow/state/durable-history.json
.workflow/state/hybrid-session.json
.workflow/state/gate-confidence.json
.workflow/state/export-map.json
.workflow/state/hybrid-context.md
.workflow/state/component-index.json
.workflow/state/app-map.md
.workflow/state/decisions.md
.workflow/state/feedback-patterns.md
.workflow/state/durable-*.json
.workflow/state/bridge-sync.json

# Digest sessions (transcript processing) - legacy location
.workflow/state/digests/

# Temp processing files (long input processing)
.workflow/tmp/

# Memory database (vector embeddings)
.workflow/memory/

# Task/change tracking (user data)
.workflow/changes/**/*.md
!.workflow/changes/.gitkeep

# Verification artifacts (task-specific)
.workflow/verifications/**
!.workflow/verifications/.gitkeep

# Specification files (task-specific)
.workflow/specs/**
!.workflow/specs/.gitkeep

# Internal roadmap
.workflow/roadmap/roadmap.md

# ===========================================
# User-specific settings (Claude Code)
# ===========================================
.claude/settings.local.json
.claude/plans/

# Auto-generated rules (regenerated from decisions.md)
.claude/rules/

# Skills developed by user (keep directory structure)
.claude/skills/*/
!.claude/skills/.gitkeep

# ===========================================
# Claude docs (auto-generated during onboarding)
# ===========================================
.claude/docs/architecture.md
.claude/docs/stack.md
.claude/docs/testing.md
.workflow/state/task-queue.json
.workflow/plans/
.workflow/state/research-cache.json

# Team connection (contains tokens - never commit)
.workflow/team-connection.json

# Team state files (deprecated)
.workflow/state/team-state.json
.workflow/state/offline-queue.json
.workflow/state/sync-daemon.*
.workflow/state/sync-state.json
.workflow/state/knowledge-sync.json
