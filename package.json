{
  "name": "wogiflow",
  "version": "1.0.33",
  "description": "AI-powered development workflow management system with multi-model support",
  "main": "lib/index.js",
  "bin": {
    "flow": "bin/flow",
    "wogi-flow": "bin/flow"
  },
  "scripts": {
    "flow": "./scripts/flow",
    "test": "node mcp-memory-server/test.js",
    "memory-server": "node mcp-memory-server/index.js",
    "postinstall": "node scripts/postinstall.js",
    "preuninstall": "node scripts/preuninstall.js"
  },
  "files": [
    "bin/",
    "lib/",
    "scripts/",
    "templates/",
    ".workflow/templates/",
    ".workflow/agents/",
    ".workflow/bridges/",
    ".workflow/lib/",
    ".workflow/state/*.template",
    ".workflow/specs/*.template",
    ".claude/commands/",
    ".claude/docs/",
    ".claude/rules/",
    ".claude/skills/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "workflow",
    "ai",
    "development",
    "claude",
    "gemini",
    "opencode",
    "mcp",
    "multi-model",
    "automation",
    "developer-tools"
  ],
  "author": "Wogi-Git",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wogi-Git/wogi-flow.git"
  },
  "bugs": {
    "url": "https://github.com/Wogi-Git/wogi-flow/issues"
  },
  "homepage": "https://github.com/Wogi-Git/wogi-flow#readme",
  "dependencies": {
    "sql.js": "^1.10.0"
  },
  "optionalDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@xenova/transformers": "^2.15.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
